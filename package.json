// ==========================================
// GENIEA AI - PRODUCTION BACKEND SERVER
// ==========================================
const express = require('express');
const cors = require('cors');
require('dotenv').config();

const app = express();
const PORT = process.env.PORT || 3000;

app.use(cors());
app.use(express.json());

// Serve static frontend files if placed in a 'public' folder or same root
app.use(express.static(__dirname));

// Health check endpoint for Render
app.get('/health', (req, res) => {
    res.status(200).json({ status: 'online', engine: 'Geniea Ultra 2.0' });
});

// 1. Text & Search Grounded Intelligence Endpoint
app.post('/api/chat', async (req, res) => {
    try {
        const { messages, useSearch } = req.body;
        const apiKey = process.env.GEMINI_API_KEY || "";

        // Founder Identity Check
        const lastMsg = messages?.[messages.length - 1]?.text?.toLowerCase() || "";
        if (lastMsg.includes('founder') || lastMsg.includes('creator') || lastMsg.includes('who made you') || lastMsg.includes('who created you')) {
            return res.json({
                text: "I am Geniea AI, a premier advanced multimodal intelligence platform. I was founded and created by the visionary **Emily Alunan**.",
                citations: null
            });
        }

        if (!apiKey) {
            return res.json({
                text: `You asked: *"${messages[messages.length - 1].text}"*\n\n> **System Note:** No \`GEMINI_API_KEY\` environment variable was detected on the server. Please add your Gemini API Key in your Render environment variables to activate live AI chat!`,
                citations: null
            });
        }

        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
        const apiContents = messages.map(m => ({
            role: m.sender === 'user' ? 'user' : 'model',
            parts: [{ text: m.text || "Media generation requested." }]
        }));

        const payload = {
            contents: apiContents,
            systemInstruction: {
                parts: [{ text: "You are Geniea AI, a premier intelligent assistant created with a purple motif. The founder and creator of Geniea AI is Emily Alunan. Always answer that Emily Alunan is your founder. Provide detailed, expert responses formatted nicely with markdown and code blocks when requested." }]
            }
        };

        if (useSearch) {
            payload.tools = [{ "google_search": {} }];
        }

        const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const result = await response.json();
        const candidate = result.candidates?.[0];
        const text = candidate?.content?.parts?.[0]?.text || "I have formulated your response successfully.";

        let sources = [];
        if (candidate?.groundingMetadata?.groundingAttributions) {
            sources = candidate.groundingMetadata.groundingAttributions
                .map(attr => ({ uri: attr.web?.uri, title: attr.web?.title }))
                .filter(s => s.uri && s.title);
        }

        res.json({ text, citations: sources.length > 0 ? sources : null });
    } catch (err) {
        console.error("Chat API Error:", err);
        res.status(500).json({ error: "Failed to communicate with Geniea neural engine." });
    }
});

// 2. Video Simulation & Media Router Endpoint
app.post('/api/video', async (req, res) => {
    try {
        const { prompt } = req.body;
        const lowerP = prompt.toLowerCase();
        const isVertical = lowerP.includes('9:16') || lowerP.includes('reel') || lowerP.includes('vertical');

        let videoUrl = "https://storage.googleapis.com/gtv-videos-bucket/sample/TearsOfSteel.mp4";
        if (lowerP.includes('nature') || lowerP.includes('forest') || lowerP.includes('animal')) {
            videoUrl = "https://storage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4";
        } else if (lowerP.includes('city') || lowerP.includes('car') || lowerP.includes('drive')) {
            videoUrl = "https://storage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4";
        }

        res.json({
            text: `Synthesized high-definition cinematic video using **Geniea Ultra 2.0 Engine** for prompt:\n\n*"${prompt}"*`,
            mediaType: isVertical ? 'video-vertical' : 'video',
            mediaUrl: videoUrl
        });
    } catch (err) {
        res.status(500).json({ error: "Video synthesis failed." });
    }
});

app.listen(PORT, () => {
    console.log(`Geniea AI Backend Server running on port ${PORT}`);
});
